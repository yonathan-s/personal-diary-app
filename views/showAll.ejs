<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Diary entries </title>
</head>
<body>
    
    <% entries.forEach(entry=>{ %>
    <div>
        <h2><%= entry.title%> </h2>
        <p><%= entry.description%> </p>
        <p><%= entry.date%> </p>
    </div>
    <br>
    <% }) %>
</body>
</html>